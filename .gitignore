# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

node_modules
.next
.env
.DS_Store
dist
build
coverage

# Recovery exports and local credentials (never commit real values).
*recovery*codes*
*backup*codes*
*.key
*.p12
*.pfx
id_rsa
id_ed25519
.aws/
.config/gcloud/
credentials.json
service-account*.json
/.tools/

# Templates may be committed; the secret scanner still checks their contents.
!.env.example
!.env.sample
!.env.template

# Dedicated, generated Supabase local workspace; contains local credentials.
/.supabase-local/
/supabase/.temp/
/supabase/.branches/
