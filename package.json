{
  "name": "becook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/local-supabase.cjs dev",
    "test:supabase": "node --require ./scripts/register-typescript.cjs scripts/test-supabase-week.ts",
    "test:supabase:read-latest-week": "node --require ./scripts/register-typescript.cjs scripts/test-read-latest-week.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "secrets:check": "node scripts/check-secrets.cjs",
    "secrets:test": "node --test tests/secrets.test.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./scripts/register-typescript.cjs --test tests/*.test.cjs",
    "benchmark:menu": "node scripts/benchmark-menu.cjs",
    "dev:local": "node scripts/local-supabase.cjs dev",
    "db:start": "node scripts/local-supabase.cjs start",
    "db:stop": "node scripts/local-supabase.cjs stop",
    "db:reset": "node scripts/local-supabase.cjs reset",
    "db:migrate": "node scripts/local-supabase.cjs migrate",
    "db:seed": "node scripts/local-supabase.cjs seed",
    "test:db": "node scripts/test-local-db.cjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.8",
    "openai": "^6.47.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
